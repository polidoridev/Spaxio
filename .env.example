# Server-side email configuration. Existing Vercel project already has these keys.
# Copy to .env.local for local use. Never commit credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=contact@polidori.dev
# Use a Google app password for an eligible account, not your normal password.
SMTP_PASS=
# All website inquiries go to contact@polidori.dev (set in lib/contact.ts).
